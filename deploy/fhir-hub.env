# Environment for the fhir-hub systemd unit.
# systemd parses this itself, not a shell: no `export`, no command substitution, and quotes
# are only needed around values with spaces. Every name below is read by
# src/main/resources/application.yaml through Boot's relaxed binding — the yaml is the list
# of record, and each of these has a default there that points at the TEST environment.

# --- Prescriptor ------------------------------------------------------------------------
# The XML-RPC dispatch endpoint. Validated as a URL at startup, so a typo fails the unit;
# it is not called until the first request, so a wrong-but-valid host does not.
PRESCRIPTOR_TARGET_URL=https://alfa.prescriptor-test.nl/api/prescriptor/xmlrpc_dispatch.php

# --- G-Standaard ------------------------------------------------------------------------
# Read-only reference lookup: resolves current medication (PRK/HPK) to the PRK+GPK pair
# Prescriptor needs for medication surveillance. Hikari opens this pool during startup, so
# an unreachable host fails the unit rather than the first session.
GSTANDAARD_DB_URL=jdbc:mariadb://192.168.31.9:3306/gstandaard_views?serverTimezone=CET&useSSL=false
GSTANDAARD_DB_USER=adapter
GSTANDAARD_DB_PASSWORD=adapter

# --- Service ----------------------------------------------------------------------------
PORT=8080

# The log file. Setting this is what makes Boot register a file appender at all - unset, the
# service logs to the console only, which is how a developer running the jar behaves. The
# layout and the rotation policy are NOT here: they live in application.yaml, because they are
# behaviour rather than deployment. Only the destination is a per-host decision.
#
# Rolled archives land beside it as fhir-hub.log.YYYY-MM-DD.0.gz, daily, kept 90 days.
LOGGING_FILE_NAME=/var/log/digitalis/fhir-hub/fhir-hub.log

# Console logging stays on, so journald keeps its copy and `journalctl -u fhir-hub -f` works
# as usual. That is duplication and it is affordable: measured volume is 16 lines per boot
# and a served request logs nothing. Set false to make the file the only destination - but
# note journald then loses the JVM's own pre-logging output, which is where
# `-XX:+ExitOnOutOfMemoryError` prints its one line.
# LOGGING_CONSOLE_ENABLED=false

# INFO, DEBUG, WARN. Applies to nl.digitalis.fhirhub only — HAPI is pinned at WARN in the
# yaml because it narrates every registered operation at startup.
LOG_LEVEL=INFO

# Profile validation, on by default. Listed here because an operator chasing a 400 will find
# it anyway: setting it false does not make a bad payload work, it makes the service forward
# one unchecked. Medication surveillance fails closed by design and this is the switch that
# reopens it, so it is a development aid and not a production setting.
# FHIRHUB_VALIDATION_ENABLED=true
