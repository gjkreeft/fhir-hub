target/
*.class
.classpath
.project
.settings/
.idea/
*.iml
.DS_Store

# IG tooling: SUSHI and the packages/validator it downloads. The FSH under ig/input/fsh is the
# source of record.
#
# ig/fsh-generated IS committed, deliberately: the runtime validator loads those profiles off
# the classpath, and the Docker build runs Maven without node, so it cannot regenerate them.
# Rebuild with `cd ig && npx sushi .` after editing any FSH — IgProfilesTest fails if the
# committed output no longer covers what the code expects.
ig/node_modules/
ig/.pkg/

# The published site and everything the IG Publisher needs to build it. `ig/input/pagecontent`
# is generated from IMPLEMENTATION_GUIDE.md by ig/scripts/build-pages.mjs — the guide and
# ig/pages are the sources of record, and editing a file under pagecontent loses the edit on the
# next build.
ig/input/pagecontent/
ig/output/
ig/output_comparison/
ig/temp/
ig/template/
ig/input-cache/
# Written into ig/ by the publisher, not by anything here.
ig/Requirements-fromNarrative.json
