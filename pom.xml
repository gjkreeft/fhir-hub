<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>nl.digitalis</groupId>
	<artifactId>fhir-hub</artifactId>
	<version>1.0.0-SNAPSHOT</version>

	<name>fhir-hub</name>
	<description>FHIR R4 interface for Digitalis Prescriptor 3</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
		<spring.boot.version>4.1.1</spring.boot.version>
		<hapi.fhir.version>8.12.0</hapi.fhir.version>
		<junit.version>6.1.3</junit.version>
		<wiremock.version>3.13.2</wiremock.version>
		<mariadb.version>3.5.10</mariadb.version>
		<h2.version>2.4.240</h2.version>
		<hikari.version>7.0.2</hikari.version>
		<!-- Boot 4.1.1's own Spring Framework version; keep them in step. -->
		<spring.web.version>7.0.9</spring.web.version>
		<jackson.version>2.22.2</jackson.version>
	</properties>

	<!--
		Boot's curated versions, imported for their effect on TRANSITIVE dependencies. This is
		dependencyManagement only, not the parent POM: the house convention of declaring every
		direct dependency with its own explicit version is unchanged, and those declarations
		still win over anything here.

		Without it, Maven arbitrates overlapping transitives by nearest-wins, which silently
		DOWNGRADES: HAPI FHIR's jakarta.annotation-api 2.1.1 beat Boot's 3.0.0, and httpclient's
		commons-logging 1.2 beat 1.3.5. The BOM makes one mutually-tested set authoritative
		instead, and maven-enforcer's requireUpperBoundDeps below fails the build if a downgrade
		ever reappears.
	-->
	<dependencyManagement>
		<dependencies>
			<!--
				Jackson is aligned FIRST, so it wins over Boot's BOM below — the first import of a
				managed version is the one that applies.

				The requirement that matters comes from the reference validator:
				ca.uhn.hapi.fhir:org.hl7.fhir.validation needs jackson-databind 2.22.1, while Boot
				4.1.1 manages 2.21.5 — so the version here has to be at least the former. It is the
				current 2.x release rather than exactly 2.22.1, which satisfies the same rule and
				keeps the tree on one supported line. Leaving Boot in charge
				would DOWNGRADE the validator's own dependency, which is the exact failure
				requireUpperBoundDeps exists to catch, and does catch: drop this import and the
				build fails rather than the validator.

				Boot is not the loser it looks like: spring-boot-starter-jackson is excluded from
				starter-web, so nothing in this application asks Spring to serialise JSON. Jackson
				is here for HAPI, which is what the exclusion below already says.
			-->
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${jackson.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring.boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!--
				HAPI FHIR 8.10.1 needed two more pins here, for divergence inside its own tree that
				Boot's BOM does not cover: hapi-fhir-base was reachable at 8.10.0 as well as
				8.10.1, and the OpenTelemetry annotations at 2.26.1 as well as 2.27.0, with
				nearest-wins picking the older one of each. 8.12.0 resolves both to a single
				version on its own, so the pins are gone rather than kept as decoration.
				requireUpperBoundDeps below is what makes that safe to do: if either divergence
				returns in a later HAPI, the build fails and names it, which is the whole reason
				the rule is configured.

				Do not re-add a pin without checking it is still load-bearing — `mvn validate`
				with it removed answers that in one run.
			-->

			<!--
				Reachable at three versions once the validator and its Caffeine cache are on the
				tree — 2.49.0 via caffeine, 2.41.0 via gson, 2.26.1 via guava — and nearest-wins
				picks 2.41.0, below what caffeine asks for. Compile-time annotations only, so
				nothing would break at runtime; pinned anyway, because the alternative is teaching
				people to wave the enforcer through.

				Pinned to the current release rather than to caffeine's 2.49.0. Anything at or
				above the highest requirement satisfies the rule, and for an annotations-only jar
				with CLASS retention there is nothing on the runtime side to be compatible with.
			-->
			<dependency>
				<groupId>com.google.errorprone</groupId>
				<artifactId>error_prone_annotations</artifactId>
				<version>2.50.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!--
			The DI container, @ConfigurationProperties binding and logging. Not
			spring-boot-starter-web: that adds Spring MVC, and this application has no
			@RestController, no @RequestMapping and no use for a DispatcherServlet — the FHIR
			servlet is registered directly against the container. See the tomcat starter below.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
			<version>${spring.boot.version}</version>
		</dependency>

		<!--
			The embedded servlet container, and Boot's glue for starting one. HAPI's RestfulServer
			is a jakarta.servlet.HttpServlet, so a container is not optional; what is optional is
			the MVC stack that starter-web would bring with it.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<version>${spring.boot.version}</version>
		</dependency>

		<!--
			RestClient, for the one outbound call this service makes. The only part of spring-web
			in use; moving PrescriptorClient to the JDK's HttpClient would remove it.
		-->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<version>${spring.web.version}</version>
		</dependency>

		<!--
			The connection pool behind GStandaardJdbcConfig, taken directly rather than through
			spring-boot-starter-jdbc. The starter's contribution was JdbcTemplate and a builder
			that picks a pool off the classpath; this application issues one prepared statement,
			from one class, against a pool it names explicitly — so the starter's six jars bought
			nothing. Version follows Boot's BOM, which is what tested this Hikari against the rest.
		-->
		<dependency>
			<groupId>com.zaxxer</groupId>
			<artifactId>HikariCP</artifactId>
			<version>${hikari.version}</version>
		</dependency>

		<!-- HAPI FHIR: R4 model, parsers, and the annotation-driven plain server -->
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-structures-r4</artifactId>
			<version>${hapi.fhir.version}</version>
			<exclusions>
				<!--
					org.hl7.fhir.utilities carries the reference validator's HTTP client and its XSLT
					helper. Neither is reachable from this service.

					okhttp backs org.hl7.fhir.utilities.http, whose only consumers outside that package
					are the R5 REST client (r5/utils/client/network/FhirRequestBuilder), the package-cache
					and terminology clients, and the validator CLI. FhirValidationConfig builds a chain of
					PrePopulated + Default + InMemoryTerminologyServer support and registers no remote
					terminology service, so nothing constructs any of them — the profiles are read from the
					jar and no request leaves the process. InstanceValidator's one reference into that
					package is HTTPResultException, a plain exception class that stays behind.

					Saxon is reached only from XsltUtilities, which nothing on this tree calls at all.
					Excluding it takes org.xmlresolver with it; note the second exclusion on
					hapi-fhir-validation below, which reaches the same jar by a second path.
				-->
				<exclusion>
					<groupId>net.sf.saxon</groupId>
					<artifactId>Saxon-HE</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.squareup.okhttp3</groupId>
					<artifactId>okhttp-jvm</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.squareup.okio</groupId>
					<artifactId>okio</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-server</artifactId>
			<version>${hapi.fhir.version}</version>
			<exclusions>
				<!--
					Subscription email delivery. MailSvc is referenced by nothing but its own interface —
					the code that would send is in hapi-fhir-jpaserver, which is not here, and a stateless
					proxy has no subscriptions to deliver. Takes angus-mail and jakarta.activation with it.
				-->
				<exclusion>
					<groupId>org.simplejavamail</groupId>
					<artifactId>simple-java-mail</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!--
			Runtime validation of the payloads against the profiles in ig/. This is the module
			that pulls in org.hl7.fhir.* — the reference validator — so it is by far the heaviest
			thing on the classpath; see FhirValidationConfig for what that costs.
		-->
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-validation</artifactId>
			<version>${hapi.fhir.version}</version>
			<exclusions>
				<!--
					The reference validator is packaged for the IG Publisher and the validator CLI, and
					those tools' dependencies come with it. Each of these is reachable from exactly one
					entry point that this service never calls; the build fails loudly if that stops being
					true, because warmUpValidator runs a real validation at startup and a NoClassDefFoundError
					is an Error, not the RuntimeException that runner catches.

					  plantuml  net.sourceforge.plantuml, 16.5 MB — r5/renderers/ExampleScenarioRenderer
					  jgit      org.eclipse.jgit, 3.3 MB      — r5/utils/NPMPackageGenerator
					  sqlite    org.xerial:sqlite-jdbc, 11.4 MB — convertors/misc/{OMOPImporter,CPTImporter}
					  Saxon     net.sf.saxon, 7.1 MB          — utilities/XsltUtilities; see structures-r4

					What is NOT excluded, and was tried: thymeleaf (hapi-fhir-base uses its Validate class
					in ValidationSupportContext), icu4j (InstanceValidator formats plural messages through
					I18nBase.getPluralKey), and nimbus-jose-jwt (InstanceValidator.checkSpecials needs it to
					validate any Bundle). All three fail the test suite within a second of being removed.
				-->
				<exclusion>
					<groupId>net.sourceforge.plantuml</groupId>
					<artifactId>plantuml-mit</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.eclipse.jgit</groupId>
					<artifactId>org.eclipse.jgit</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.xerial</groupId>
					<artifactId>sqlite-jdbc</artifactId>
				</exclusion>
				<exclusion>
					<groupId>net.sf.saxon</groupId>
					<artifactId>Saxon-HE</artifactId>
				</exclusion>
							<!--
					Three of the five FHIR versions the reference validator carries. It is written
					against R5 internally and converts what it validates up to it, so R4 and R5 are
					both live, and DSTU3 is as well: ValidationSupportUtils.extractCodeSystemForCode
					switches over dstu3/r4/r5 ValueSets in one method and fails to link without it.

					DSTU2, DSTU2016May and R4B are reached only from per-version branches of
					CommonCodeSystemsTerminologyService and InMemoryTerminologyServerValidationSupport,
					both of which are in this service's chain but dispatch on the FhirContext's
					version. FhirConfig creates exactly one context, FhirContext.forR4(), so those
					branches are unreachable by construction rather than merely untested. 21 MB.

					If a second FhirContext at another version is ever introduced, these come back —
					and the failure is a NoClassDefFoundError from inside terminology validation,
					not a compile error.
				-->
				<exclusion>
					<groupId>ca.uhn.hapi.fhir</groupId>
					<artifactId>org.hl7.fhir.dstu2</artifactId>
				</exclusion>
				<exclusion>
					<groupId>ca.uhn.hapi.fhir</groupId>
					<artifactId>org.hl7.fhir.dstu2016may</artifactId>
				</exclusion>
				<exclusion>
					<groupId>ca.uhn.hapi.fhir</groupId>
					<artifactId>org.hl7.fhir.r4b</artifactId>
				</exclusion>
				<!--
					The XmlPull parser, and the exclusion with the least margin — see
					XhtmlNarrativeParsingTest, which is what makes it safe to keep. Its classes are
					referenced two thousand times across the validator, almost all of it from
					org.hl7.fhir.r5.formats.XmlParser, which parses R5 XML text and is not how
					anything gets parsed here: HAPI reads inbound XML with StAX and the validator
					walks the element model over DOM.

					Excluded for its paperwork rather than its 0.4 MB. org.ogce:xpp3 is a
					re-publication of a project last released in 2005, it declares no licence in
					its POM, and it carries jakarta-regexp 1.4, which declares none either. Two
					SOUP items with no identifiable supplier and no anomaly list to review is a
					harder thing to answer for under IEC 62304 7.1.2 than anything they do.
				-->
				<exclusion>
					<groupId>org.ogce</groupId>
					<artifactId>xpp3</artifactId>
				</exclusion>
</exclusions>
		</dependency>

		<!--
			The R4 core conformance resources — the StructureDefinitions for Parameters, Bundle,
			Patient and the rest — ship separately from the model classes. Without this,
			DefaultProfileValidationSupport resolves nothing at all (fetchAllStructureDefinitions
			returns 0), and the first request dies with "HAPI-0705: Unknown base definition:
			.../Parameters" while trying to snapshot a profile whose base cannot be found.
		-->
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-validation-resources-r4</artifactId>
			<version>${hapi.fhir.version}</version>
		</dependency>

		<!--
			HAPI resolves its cache implementation through a ServiceLoader and ships none by
			default: CachingValidationSupport throws "HAPI-2200: No Cache Service Providers found"
			at construction without this. Caffeine is HAPI's own default; the Guava alternative
			is for Android.
		-->
		<dependency>
			<groupId>ca.uhn.hapi.fhir</groupId>
			<artifactId>hapi-fhir-caching-caffeine</artifactId>
			<version>${hapi.fhir.version}</version>
		</dependency>


		<!-- G-Standaard reference lookups run over JDBC; MariaDB in every environment. -->
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<version>${mariadb.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<version>${spring.boot.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>${wiremock.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Stands in for the G-Standaard medcode view so tests need no live database. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<!--
			Declaring any <resource> replaces the default, so src/main/resources is repeated here.
			The second entry puts the IG's conformance resources on the classpath for
			FhirValidationConfig to load. Only StructureDefinition, ValueSet and CodeSystem are
			taken: the IG also generates the documentation examples, which are not conformance
			resources and would only be noise in the jar.
		-->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>ig/fsh-generated/resources</directory>
				<targetPath>fhir-profiles</targetPath>
				<includes>
					<include>StructureDefinition-*.json</include>
					<include>ValueSet-*.json</include>
					<include>CodeSystem-*.json</include>
				</includes>
			</resource>
		</resources>

		<!--
			The SBOM, and the input to the SOUP list. IEC 62304 wants every third-party item that
			ships identified by supplier and version; MDCG 2019-16 and IEC 81001-5-1 want that same
			list machine-readable so vulnerabilities can be tracked against it after release. One
			generated file serves both, and generating it from the resolved tree is the point — a
			hand-maintained SOUP list is wrong the first time a transitive version moves, and
			nothing tells you.

			Managed rather than bound: nothing generates an SBOM on an ordinary `mvn install`,
			because it costs a dependency re-resolution and a schema validation on every build for
			a file that only matters at release. Two ways to ask for one:

			    mvn -Psbom package      # bound to the package phase, for a release build
			    mvn cyclonedx:makeBom   # on demand, no build required

			Both take the configuration below, which is why it lives here and not in the profile.

			Test-scope dependencies are deliberately excluded: SOUP is software that ships in the
			device. WireMock, H2 and JUnit are development tools, which carry a tool-selection
			obligation instead, not a SOUP one. Keeping them out of this file is what makes that
			distinction auditable rather than asserted.
		-->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.cyclonedx</groupId>
					<artifactId>cyclonedx-maven-plugin</artifactId>
					<version>2.9.3</version>
					<configuration>
						<schemaVersion>1.6</schemaVersion>
						<outputFormat>all</outputFormat>
						<outputName>sbom</outputName>
						<includeCompileScope>true</includeCompileScope>
						<includeRuntimeScope>true</includeRuntimeScope>
						<includeProvidedScope>false</includeProvidedScope>
						<includeSystemScope>false</includeSystemScope>
						<includeTestScope>false</includeTestScope>
						<includeLicenseText>false</includeLicenseText>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!--
				Guards the version coherence the dependencyManagement block above establishes.
				requireUpperBoundDeps fails the build when Maven resolves an artifact to a LOWER
				version than some path requires — the silent-downgrade case, which is the one that
				actually breaks at runtime rather than at build time.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-dependency-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireUpperBoundDeps/>
								<banDuplicatePomDependencyVersions/>
								<!--
									Jackson is taken from exactly one place: HAPI FHIR, which pins
									its own version and serialises every /fhir/* response. Nothing
									here needs Spring to serialise JSON, and a second Jackson in
									the tree is two versions of the same artifacts for Maven to
									arbitrate — the collision CLAUDE.md describes, which surfaces
									as a NoClassDefFoundError at RestClient construction rather
									than at the boundary that caused it.

									This used to be an <exclusion> on spring-boot-starter-web. That
									starter is gone, and nothing on the tree pulls Boot's Jackson
									starter today, so the exclusion had nothing to hang on. A ban
									keeps the guarantee anyway: if a Boot upgrade or a new starter
									reintroduces it, the build fails and says why.
								-->
								<bannedDependencies>
									<excludes>
										<exclude>org.springframework.boot:spring-boot-starter-jackson</exclude>
									</excludes>
									<message>
										Jackson comes from HAPI FHIR only. Something reintroduced
										spring-boot-starter-jackson: exclude it there, or read the
										Jackson note in CLAUDE.md before changing this rule.
									</message>
								</bannedDependencies>

								<!--
									The IG Publisher's dependencies, excluded from the three HAPI
									artifacts that reach them today. A ban as well as the
									exclusions, because Maven prunes per path: an exclusion only
									removes the jar from the subtree it is written on, and which
									subtree reaches which jar is HAPI's business, not ours. Four of
									these needed an exclusion on one dependency and would have
									returned through another after an upgrade.

									If this rule fires, the artifact came back by a new path. Add
									the exclusion there — do not relax the rule — and check the
									exclusion comments in the dependencies above first, because
									they record why each one is safe to remove and what happens
									when it is not.
								-->
								<bannedDependencies>
									<excludes>
										<exclude>net.sourceforge.plantuml:plantuml-mit</exclude>
										<exclude>org.eclipse.jgit:org.eclipse.jgit</exclude>
										<exclude>org.xerial:sqlite-jdbc</exclude>
										<exclude>net.sf.saxon:Saxon-HE</exclude>
										<exclude>com.squareup.okhttp3:*</exclude>
										<exclude>com.squareup.okio:*</exclude>
										<exclude>org.simplejavamail:*</exclude>
										<exclude>ca.uhn.hapi.fhir:org.hl7.fhir.dstu2</exclude>
										<exclude>ca.uhn.hapi.fhir:org.hl7.fhir.dstu2016may</exclude>
										<exclude>ca.uhn.hapi.fhir:org.hl7.fhir.r4b</exclude>
										<exclude>org.ogce:xpp3</exclude>
										<exclude>jakarta-regexp:jakarta-regexp</exclude>
									</excludes>
									<message>
										A dependency of the IG Publisher and the validator CLI is
										back on the runtime classpath. Nothing in a stateless proxy
										renders diagrams, builds NPM packages, imports OMOP, runs
										XSLT, sends mail or makes an HTTP call from the validator.
										Exclude it on whichever HAPI dependency now reaches it.
									</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${spring.boot.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Attaches the SBOM to a release build: `mvn -Psbom clean verify`. The version and the
			configuration come from pluginManagement above, so this profile says only *when*.
		-->
		<profile>
			<id>sbom</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.cyclonedx</groupId>
						<artifactId>cyclonedx-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>sbom</id>
								<phase>package</phase>
								<goals>
									<goal>makeBom</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
